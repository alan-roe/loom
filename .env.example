# Local development configuration
# Copy this file to .env and fill in your values

# Dev mode bypasses authentication (auto-creates dev user)
LOOM_SERVER_AUTH_DEV_MODE=1

# Anthropic OAuth pool for Claude Max subscriptions
# LOOM_SERVER_ANTHROPIC_OAUTH_ENABLED=true
# LOOM_SERVER_ANTHROPIC_OAUTH_CREDENTIAL_FILE="/path/to/anthropic-oauth.json"

# Or use an API key instead of OAuth pool
# LOOM_SERVER_ANTHROPIC_API_KEY=sk-ant-...

# Logging level
RUST_LOG=info
